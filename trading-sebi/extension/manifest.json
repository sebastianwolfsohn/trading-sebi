{
  "manifest_version": 3,
  "name": "Trading Sebi",
  "version": "0.1.0",
  "description": "Manda automáticamente a tu journal Trading Sebi cada ejecución que hacés en TradingView con Tradovate.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Trading Sebi", "default_popup": "options.html" },
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
